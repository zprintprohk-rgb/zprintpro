import { Metadata } from "next";
import UnsubscribeClient from "../UnsubscribeClient";

export const runtime = "edge";

interface UnsubscribeIdPageProps {
  params: { locale: string; id: string };
  searchParams?: { [key: string]: string | string[] | undefined };
}

const metaTitles: Record<string, string> = {
  "zh-hk": "取消訂閱 | 智印港 ZprintPro",
  en: "Unsubscribe | ZprintPro",
  ja: "配信停止 | ジープリント ZprintPro",
};

export async function generateMetadata({ params }: UnsubscribeIdPageProps): Promise<Metadata> {
  const locale = metaTitles[params.locale] ? params.locale : "zh-hk";
  return { title: metaTitles[locale], robots: { index: false, follow: false } };
}

export default function UnsubscribeIdPage({ params, searchParams }: UnsubscribeIdPageProps) {
  const locale = ["zh-hk", "en", "ja"].includes(params.locale) ? params.locale : "zh-hk";
  const e = typeof searchParams?.e === "string" ? searchParams.e : "";
  const refId = params.id || "";
  return <UnsubscribeClient locale={locale} refId={refId} email={e} />;
}
