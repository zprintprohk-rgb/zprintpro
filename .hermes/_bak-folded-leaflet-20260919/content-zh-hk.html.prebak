    <tr><td><a href="/product/thick-paper-flyers/">厚紙傳單（FL-005）</a></td><td>200g / 250g 銅版紙</td><td>A4 或 A5</td><td>HK$0.45-1.20/張</td><td>10 張</td></tr>
    <tr><td><strong><a href="/product/folded-leaflets/">摺疊傳單（FL-004）</a></strong></td><td>157g / 200g 銅版紙</td><td>A4 展開 或 DL</td><td><strong>HK$0.70-1.95/張</strong></td><td><strong>10 張</strong></td></tr>
  </tbody>
