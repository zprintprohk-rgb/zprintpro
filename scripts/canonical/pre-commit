#!/bin/bash
# scripts/canonical/pre-commit (SSoT)
# 反审门童 v1 (K3 9/1 15:06 拍板) — canonical pre-commit hook
#
# 5 道门童 + 3 道防线 + 自进化 4 步 SOP
# - 🔴 red (电话/品牌/跨语言污染严重): 硬拦 (exit 1)
# - 🟠 orange (数据诚信 11 类): shadow mode (9/1-9/15), --strict 启用硬拦
# - 🟡 yellow (i18n/SOP-10): shadow mode, --strict-all 启用硬拦
#
# 安装 (K3 9/1 15:06 修正 4: hook 持久化):
#   bash scripts/setup-hooks.sh
#
# 用法:
#   git commit -m "..."                # 默认 red 硬拦
#   git commit -m "..." --no-verify   # K3 必拍 1 次回复豁免
#   git commit -m "..." --allow=<id>  # 临时豁免 (K3 必拍)

set -e

echo "🔍 反审门童 v1 pre-commit (K3 9/1 15:06 拍板)..."

# 1. Encoding check (UTF-16 + CRLF) — 保留 v6 行为
echo "1️⃣  Encoding check..."
if command -v node &> /dev/null; then
  node scripts/check-encoding.js --fix
  if [ $? -ne 0 ]; then
    echo "❌ Encoding check failed!"
    exit 1
  fi
else
  echo "⚠️ Node not found, skipping encoding check"
fi

# 2. Simplified Chinese check (zh-hk 最高原则) — 保留 v6 行为
echo "2️⃣  Simplified Chinese check..."
if command -v node &> /dev/null; then
  node scripts/scan-simplified.mjs 2>/dev/null || echo "  (scan-simplified.mjs not found, skipping)"
fi

# 2.5 blog-data JSON 严格校验 (门童 #15, 用户 2026-09-04 拍板)
# 事故背书: 9/3-9/4 fix script 把 3 个 blog-data JSON 改坏, 生产连续 5 次 build fail,
# 本地 12 铁律门童的 lazy try/catch 静默放行 (误报 "0 命中")。
# 拍板: 任何对 blog-data JSON 的修改, 改完必须先过严格解析校验, 再进 commit。
echo "2️⃣.5  blog-data JSON 严格校验 (门童 #15)..."
if command -v node &> /dev/null; then
  STAGED_BLOG_JSON=$(git diff --cached --name-only -- src/data/blog-data/zh-hk.json src/data/blog-data/en.json src/data/blog-data/ja.json)
  if [ -n "$STAGED_BLOG_JSON" ]; then
    node scripts/guards/blog-data-integrity-guard.js
    if [ $? -ne 0 ]; then
      echo ""
      echo "❌ 门童 #15 拦截: blog-data JSON 严格校验未通过 (生产部署必挂)"
      echo ""
      echo "💡 修法:"
      echo "  1. 从最近合法 commit 还原 (实测 6c2f4a94 三语全合法: zh-hk 81 / en 82 / ja 82 keys)"
      echo "  2. 用 JSON.stringify / json.dumps 重新序列化, 禁止手写转义补丁 (状态机已失败 2 次)"
      echo "  3. node scripts/guards/blog-data-integrity-guard.js 复验全过后再 commit"
      exit 1
    fi
  else
    # 本次未改 blog-data JSON: 廉价全检, 仅警告不拦截 (提示工作树已损坏, 部署会挂)
    node scripts/guards/blog-data-integrity-guard.js > /dev/null 2>&1
    if [ $? -ne 0 ]; then
      echo "⚠️  警告: 工作树 blog-data JSON 校验未通过 (未在本次 staged, 不拦截; 但生产构建会失败, 请尽快修复)"
    fi
  fi
else
  echo "⚠️ Node not found, skipping blog-data JSON 严格校验"
fi

# 3. 反审门童 v1 — K3 9/1 15:06 拍板落地
echo "3️⃣  反审门童 v1 (5 道门童 + 3 道防线)..."
if command -v node &> /dev/null; then
  # --commit 模式: 仅扫 staged 文件 (< 5s, pre-commit hook 性能优化)
  # 严重度口径 = K3 9/1 15:06 修正 3「shadow mode 分级执法」: **red 硬拦 / orange·yellow 仅警告 (9/15 转正)**
  #   ⚠️ 2026-09-13 修正: 原写 `--commit --strict` 与该拍板冲突 (orange 也硬拦 => 内容类文件因存量 orange 命中无法提交);
  #   品牌类 red 规则另有 .hermes/brand-baseline.json 存量扣减 (方案 C), 只拦新增。
  #   👉 9/15 转正时改回 `--commit --strict`
  node scripts/check-regression-guard.js --commit
  EXIT_CODE=$?
  if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ 反审门童拦截 (exit 1)"
    echo ""
    echo "💡 修法选项:"
    echo "  1. 改 src/ 内容, 撤除命中规则"
    echo "  2. 同步写 .hermes/regression-guard/error-patterns.md (DoD 铁律)"
    echo "  3. git commit --no-verify (K3 必拍 1 次回复豁免)"
    exit 1
  fi
else
  echo "⚠️ Node not found, skipping regression guard"
fi

# 3.5 门童 #3 全量基线闸门 (K3 2026-09-13 批准方案 C)
# 背景: 步骤 3 的 --commit 只扫 staged diff → 存量双品牌天然豁免 (实测 9/13 仍有 150 处)。
# 本步全量扫 src/ + messages/, 与 .hermes/brand-baseline.json 基线比对, 任何新增即拦。
echo "3️⃣.5  门童 #3 品牌分层 全量基线闸门..."
if command -v node &> /dev/null; then
  node scripts/check-brand-baseline.mjs
  EXIT_CODE=$?
  if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ 门童 #3 拦截: 双品牌新增命中 (基线只许递减)"
    echo ""
    echo "💡 修法: 按 locale 单品牌分层 (zh-hk=智印港 / en·ja=ZprintPro), 清掉新增命中后重跑"
    exit 1
  fi
fi

# 3.6 门童 #24 MOQ 口径一致性闸门 (K3 2026-09-19 指令第 5 项: push 前硬闸门)
# 编号修正: #22 = guards/bypass-audit-guard.js (旁路留痕审计),
#           #23 = guards/cron-prompts-exemption-guard.js (cron-prompts 豁免台账对账),
#           故本门童取 #24（首版误编 #22 与既有冲突, 已改）。
# 背景: MOQ 文案散落在 5 个来源层 (products.ts / seo.ts / sku-seo-data.ts /
#   products-content.ts / category-seo-content.ts), 此前靠人工巡检, 反复出现
#   「改了 PDP 忘了品類頁」「zh 改了 en/ja 没改」→ 打地鼠。
# 判据: 真值唯一定义 = src/data/products.ts 的 minQuantity (引擎实际输入);
#   任何 SKU 上下文中的起印量数字与真值不符即 FAIL。
# 设计: 已登录的「待 K3 裁决」项不阻挡 (否则存量会锁死全站 → 闸门必被绕过),
#   只挡**未登录的新漂移**; 存量项一律在报告中显示为「📋 已登录」而非 ✓。
# 实测耗时 0.8s, 可无条件执行。
# 設計 (**2026-09-20 K3 裁決 B 案: 條件式掃描域**):
#   · 舊行為 = 掃描 worktree 全 5 檔 (非 staged-only) → 併發會話在 seo.ts /
#     category-seo-content.ts 中途留下的漂移, 會**誤攔與其無關的提交**。
#   · 純 staged-only (社群 best practice) → **真值級聯會盲掉**: 只 stage 真值源
#     products.ts 時, 其他 4 檔的過期文案掃不到 → 不一致直接上線 (本波 MOQ 事故根因類型)。
#   ⇒ 條件式: **staged 含真值源 products.ts → 全 5 檔級聯檢查**;
#             **否則只掃 staged ∩ 5 個目標檔** (消除誤攔)。
#   範圍判定寫在 scanner 的 Node 裡 (--staged), 因為本 hook 有 `set -e`,
#   且 Git for Windows 的 sh 對外部工具 (paste/tr) 可用性不保證。
# 已登录的「待 K3 裁决」项不阻挡 (否则存量会锁死全站 → 闸门必被绕过),
#   只挡**未登录的新漂移**; 存量项一律在报告中显示为「📋 已登录」而非 ✓。
# ⚠️ 本块用 `if ! cmd; then` 而非 `cmd; if [ $? -ne 0 ]` —— 本 hook 第 18 行有 `set -e`,
#   语句级失败会**立即退出**, 后面的 `if` 永远到不了 ⇒ 修法提示不可达 (2026-09-20 修正)。
# 实测耗时 ~0.8s (全檔) / <0.3s (局部), 可无条件执行。
echo "3️⃣.6  门童 #24 MOQ 口径一致性闸门 (条件式扫描域)..."
if command -v node &> /dev/null; then
  # 2026-09-20 可移植性修正: 原 `npx tsx` 在無 npx 的環境 (實測 Kimi Work 託管 runtime
  # PATH 無 npx) 會 command not found → 門禁誤攔無關提交. 改為 node 直調 tsx CLI,
  # 只依賴 node + 本地 node_modules (本 hook 其餘門童同樣依賴 node), 零 PATH 假設.
  if ! node node_modules/tsx/dist/cli.mjs scripts/moq10-books-context-scan.ts --gate --staged; then
    echo ""
    echo "❌ 门童 #24 拦截: MOQ 口径漂移 (新漂移未清)"
    echo ""
    echo "💡 修法:"
    echo "  1. 改文案对齐真值, 或改 src/data/products.ts 的 minQuantity (须 K3 裁決)"
    echo "  2. 确属「待裁決」→ 登记进 scripts/moq10-books-context-scan.ts 的 PENDING_LIST (附理由)"
    echo "  3. node node_modules/tsx/dist/cli.mjs scripts/moq10-books-context-scan.ts --gate --staged 复核 (有 npx 環境可 npx tsx 同參數)"
    exit 1
  fi
fi

# 3.7 門童清單編號衝突檢查 (K3 2026-09-19 第四項建議)
# 背景事故: 新增 MOQ 閘門時只掃 check-regression-guard.js, 漏掃 scripts/guards/ 目錄
#   → 誤編 #22 (已被 bypass-audit-guard 佔用), #23 (cron-prompts-exemption-guard)
#   → push 時才發現撞號, 浪費一輪。
# 口徑: 門童編號 / 規則 ID 是**共享命名空間**, 新增前必須先查清單。
# 清單: scripts/guards/guard-manifest.json (產生器 scripts/gen-guard-manifest.mjs)
echo "3️⃣.7  門童清單編號衝突檢查..."
if command -v node &> /dev/null; then
  if [ -f scripts/gen-guard-manifest.mjs ]; then
    # ⚠️ 同上 (`set -e`): 必須用 `if ! cmd`, 否則提示不可達
    if ! node scripts/gen-guard-manifest.mjs; then
      echo ""
      echo "❌ 門童編號衝突: 同一編號被多個門童聲明"
      echo ""
      echo "💡 修法:"
      echo "  1. 查 scripts/guards/guard-manifest.json 的 maxGuardNumber, 取遞增值"
      echo "  2. 改完執行 node scripts/gen-guard-manifest.mjs --write 刷新清單"
      exit 1
    fi
  fi
fi

# 3.8 門童 #26 門童 hook SSoT/active 同步一致性 (2026-09-20)
# 背景: 門童 hook 有**兩份檔** —— SSoT = scripts/canonical/pre-commit,
#   active = core.hooksPath 指向那支 (= .githooks/pre-commit, **git 真正讀的**)。
#   只更新一份 → git 讀的 active 沒跟上; 而 hook 沒被讀到時 **git 不會報任何錯**
#   → 門禁靜默失效, 且失效本身無法自證。
#   實錄兩次同根因事故:
#     ① 2026-08-26 ~ 09-13 (18 天): 設了 hooksPath 但安裝腳本仍裝 .git/hooks/ → 整條門禁失效
#     ② 2026-09-20: SSoT 已含門童 #24, active 落後未含 → **#24 從未真的觸發過**
# 判據: 兩份檔內容 (行尾正規化後) sha256 必須相等。
#   刻意不比 mtime (per §0.35.4: 禁用 mtime 當存活證據, 9/17 全檔複製曾把 mtime 統一刷新)。
echo "3️⃣.8  門童 #26 hook SSoT/active 同步一致性..."
if command -v node &> /dev/null; then
  node scripts/guards/hook-sync-guard.js
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 門童 #26 攔截: 門童 hook SSoT 與 active 分叉 (門禁可能靜默失效)"
    echo ""
    echo "💡 修法: node scripts/install-hooks.mjs"
    exit 1
  fi
fi

# 3.9 門童 #25 SKU 標題當量帶閘門 (K3 2026-09-20 標題-GSC-關鍵詞庫增長飛輪指令)
# 規則: MIN=50 / WARN>57 / HARD>=58 (半角當量, SSoT scripts/guards/title-equiv.js, 58 阻斷線)
# 判據鐵律 (§0.35.4): 只攔 staged diff 中**新增/修改**的 title; 存量 issue 落審計 JSON 不攔.
echo "3️⃣.9  門童 #25 標題當量帶閘門 (staged 新增 ≥58 硬攔)..."
if command -v node &> /dev/null; then
  node scripts/guards/title-band-guard.js --commit
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 門童 #25 攔截: staged 新增 title 半角當量 ≥58 (阻斷線, 防 SERP 截斷 + Google 重寫)"
    echo ""
    echo "💡 修法: 修剪回 50-57 (scripts/guards/title-equiv.js 口徑), 或 K3 拍板豁免"
    exit 1
  fi
fi

# 4. DoD 铁律 (K3 9/1 15:06 齿轮 1: No fix without a rule)
echo "4️⃣  DoD 铁律 (No fix without a rule)..."
if command -v node &> /dev/null; then
  node scripts/check-regression-guard.js --commit --dod
  EXIT_CODE=$?
  if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ DoD 铁律失败: 修复错误未同步入 error-patterns.md"
    echo ""
    echo "💡 修法:"
    echo "  1. 在 .hermes/regression-guard/error-patterns.md 新增 ### <rule-id> 条目"
    echo "  2. 错误修复 + 规则沉淀 = 同一个 commit 的两部分"
    exit 1
  fi
fi

echo ""
echo "✅ 反审门童 v1 pre-commit 全部通过"
echo "  5 道门童: 0 red / 0 orange (shadow) / 0 yellow (shadow)"
echo "  DoD 铁律: 通过"
echo "  Encoding: 通过"
echo "  Simplified Chinese: 通过"
