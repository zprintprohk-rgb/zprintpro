#!/usr/bin/env bash
# 2026-08-26 K3 14:13 §4 拍板 + 19:09 拍板: 拦截 git submodule mode 160000 误提交
# 触发: git push 前 (本地 .git/hooks/pre-push, 或 core.hooksPath=.githooks)
# 防: M3 8/26 14:13 zprintpro/ nested repo 误当 submodule 提交, CF build 0s fatal fail in 0s
# 安装: 一次性执行 (K3 拍板 19:09 装, 后续 cron pre-push 自动跑)
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-push

# 检查 staged / committed 中是否有 submodule mode 160000
# git ls-files --stage: 列出 staged 文件 + mode (160000 = gitlink/submodule pointer)
submodule_count=$(git ls-files --stage 2>/dev/null | awk '$2 ~ /^160000$/' | wc -l | tr -d ' ')

if [ "$submodule_count" -gt 0 ]; then
  echo ""
  echo "🚨 [pre-push hook] 检测到 $submodule_count 个 submodule pointer (mode 160000)!"
  echo ""
  echo "Submodule 误提交会导致 CF Pages clone 步骤立刻 fatal fail in 0s:"
  echo "  fatal: No url found for submodule path 'xxx' in .gitmodules"
  echo "  Failed: error occurred while updating repository submodules"
  echo ""
  echo "问题根因: git add -A 扫到了 nested git repo, git 把它当 submodule 记录"
  echo "          但 .gitmodules 里没有 url, CF clone 找不到 url 立刻 fatal"
  echo ""
  echo "修法 3 选 1:"
  echo "  A. git rm --cached <submodule-path> + .gitignore 加 <path>/ + git commit --amend"
  echo "  B. git revert <commit-with-submodule> + git push --force-with-lease origin_ssh main"
  echo "  C. 确认 <submodule-path> 是真 submodule 后, 在 .gitmodules 加 url 定义"
  echo ""
  echo "列出误提交的 submodule:"
  git ls-files --stage 2>/dev/null | awk '$2 ~ /^160000$/ {print "  - " $4 " (mode 160000, hash: " $3 ")"}'
  echo ""
  echo "Push 已拒绝, 等修好再 push."
  echo ""
  exit 1
fi

# ── 门童 #14 (12 段骨架) + #21 (规则翻译层) — push 前必跑 (K3 2026-09-19 指令) ──
# 背景: 2026-09-19 实测「门童 #14 报 0 命中, 线上却有 12/15 个 Pillar-locale 组合丢失 FAQPage」——
#       根因 = 旧 #14 只 JSON.parse(content) 数数、从不做线上断言; 且规则没翻译到生成位置与门禁位置。
if command -v node &> /dev/null && [ -f scripts/guards/blog-quality-12-rules-guard.js ]; then
  echo ""
  echo "14 [GUARD #14] 12 段骨架 checklist + 基线对账 (只拦新增/回归段级 FAIL, 存量按批清)..."
  node scripts/guards/blog-quality-12-rules-guard.js --baseline --online --json
  if [ $? -ne 0 ]; then
    echo ""
    echo "[X] 门童 #14 拦截: 出现**新增**段级 FAIL (或线上断言出现 INVALID 导致的测量无效对比)"
    echo "    修法: 修内容/格式使该段转 PASS; 证据文件见 .hermes/reports/blog-12seg-checklist-<date>-online.json"
    echo "    网络导致的 INVALID 重跑: ZP_SKIP_ONLINE=1 git push   (仅跳过线上断言, 离线段级检查仍执行)"
    exit 1
  fi

  if [ -f scripts/guards/rule-translation-guard.js ]; then
    echo "21 [GUARD #21] 规则翻译层 (SSoT / 生成位置 / 门禁断言 三处绑定)..."
    node scripts/guards/rule-translation-guard.js
    if [ $? -ne 0 ]; then
      echo ""
      echo "[X] 门童 #21 拦截: 规则翻译层漂移"
      echo "    口径: SSoT 变更 => cron prompt(生成位置) + guards(门禁断言) 必须同步翻译, 三者绑定才算规则生效"
      echo "    修法: 三处确已更新后执行 node scripts/guards/rule-translation-guard.js --stamp, 随同一次 commit 提交"
      exit 1
    fi
  fi
fi

# 全部 OK, 放行
exit 0
