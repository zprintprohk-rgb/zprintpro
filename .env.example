# ==============================================
# ZprintPro 环境变量模板
# ==============================================
# 复制此文件为 .env.local 并填入真实值
# 真实 .env.local 不要提交到 git

# ------------ Supabase（数据库）------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------ Stripe（支付，可选）------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret

# ------------ Airwallex（卡支付 + 收款账户，2026-06-24 开通）------------
# 收单产品 API（卡支付在线收单）— 等 Airwallex 审核通过后填入
NEXT_PUBLIC_AIRWALLEX_CLIENT_ID=your_client_id
AIRWALLEX_API_KEY=your_api_key
AIRWALLEX_WEBHOOK_SECRET=your_webhook_secret

# 银行电汇 / Wire Transfer 收款账户（2026-06-24 Airwallex 多币种钱包激活）
# DBS Bank (Hong Kong) Limited, 账号 7949835442, SWIFT: DHBKHKHH
# 银行号 016 / 分行代码 478 (仅 HK 本地 RTGS/CHATS 用,跨境 SWIFT 不需要)
# 收款人地址: 广东省深圳市龙岗区平湖街道嘉城路1号 518111
# 这些信息同时给前端展示 (BankTransferInfo) + 后端落库 (orders.wire_transfer_info)
NEXT_PUBLIC_BANK_NAME=DBS Bank (Hong Kong) Limited
NEXT_PUBLIC_BANK_ACCOUNT=7949835442
NEXT_PUBLIC_BANK_ACCOUNT_HOLDER=深圳市彩龙印刷包装有限公司
NEXT_PUBLIC_BANK_SWIFT=DHBKHKHH
NEXT_PUBLIC_BANK_CODE=016
NEXT_PUBLIC_BANK_BRANCH=478
NEXT_PUBLIC_BANK_RECIPIENT_ADDRESS=Room XXX, No.1 Jiacheng Road, Pinghu Street, Longgang District, Shenzhen, Guangdong, China 518111

# 订单邮件 (Resend 发送)
RESEND_API_KEY=your_resend_api_key

# ------------ 网站配置 ------------
NEXT_PUBLIC_SITE_URL=https://zprintpro.com

# ------------ 埋点（推荐 Plausible）------------
# Plausible：轻量、隐私友好、无需 cookie banner
# 注册 https://plausible.io → 添加 zprintpro.com → 填入下方
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zprintpro.com

# Google Analytics 4（可选，与 Plausible 二选一或并存）
NEXT_PUBLIC_GA_ID=

# ------------ 客服 / 通讯 ------------
# WhatsApp 商务账号（用于服务通知，可选）
NEXT_PUBLIC_WHATSAPP_NOTIFY_NUMBER=

# ------------ EN 市场客服 (2026-06-14 zh-hk+EN 补齐必需) ------------
# EN WhatsApp 商务账号（EN 主流沟通方式），未设置时 EN 页 fallback 到 WhatsApp 通知
# 格式：+852-XXXX-XXXX (国际格式)
NEXT_PUBLIC_EN_WHATSAPP=
# EN 客服邮箱，未设置时 fallback 到 zprintpro@outlook.com
NEXT_PUBLIC_EN_EMAIL=

# ------------ JA 市场客服 (2026-06-14 Phase B 必需, 上线前填真实值) ------------
# 日本 LINE 官方账号 URL（JA 主流沟通方式），未设置时 JA 页不显示 LINE 入口
# 格式：https://line.me/R/ti/p/@zprintpro
NEXT_PUBLIC_LINE_URL=
# 日本客服电话（+81-XX-XXXX-XXXX），未设置时 JA 页不显示 +81 电话入口
NEXT_PUBLIC_JA_PHONE=
# JA 客服邮箱，未设置时 fallback 到 zprintpro@outlook.com
NEXT_PUBLIC_JA_EMAIL=

# ------------ 2026-06-14 Phase B P0-5: JA locale 强制走 JPY 结算 ------------
# 默认 false（保持 HKD 结算），上线前改为 true 启用。
# 关：JA locale 显示 JPY 但后台走 HKD（现状，存在信任问题）
# 开：JA locale 全链路 JPY 计价 + Airwallex payment intent currency=JPY
# 出问题改回 false 一秒回滚
NEXT_PUBLIC_JA_FORCE_JPY=false
