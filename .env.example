# ==============================================
# ZprintPro 环境变量模板
# ==============================================
# 复制此文件为 .env.local 并填入真实值
# 真实 .env.local 不要提交到 git

# ------------ Supabase（数据库）------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------ Stripe（支付，可选）------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret

# ------------ 网站配置 ------------
NEXT_PUBLIC_SITE_URL=https://zprintpro.com

# ------------ 埋点（推荐 Plausible）------------
# Plausible：轻量、隐私友好、无需 cookie banner
# 注册 https://plausible.io → 添加 zprintpro.com → 填入下方
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zprintpro.com

# Google Analytics 4（可选，与 Plausible 二选一或并存）
NEXT_PUBLIC_GA_ID=

# ------------ 客服 / 通讯 ------------
# WhatsApp 商务账号（用于服务通知，可选）
NEXT_PUBLIC_WHATSAPP_NOTIFY_NUMBER=
